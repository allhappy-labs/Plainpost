{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plainpost.app/protocol/node-session-v1/node-session.schema.json",
  "title": "Plainpost node-session-v1 fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "endpoint", "activation", "request", "requestBodyUTF8", "requestBodyLimit", "endpointTranscript", "activationTranscript", "requestTranscript", "requestDigest"],
  "properties": {
    "kind": { "const": "node-session-v1.fixture" },
    "schemaVersion": { "const": 1 },
    "endpoint": { "$ref": "#/$defs/endpoint" },
    "activation": { "oneOf": [{ "$ref": "#/$defs/activationV2" }, { "$ref": "#/$defs/activationV3" }] },
    "request": { "$ref": "#/$defs/request" },
    "requestBodyUTF8": { "type": "string" },
    "requestBodyLimit": { "const": 1048576 },
    "endpointTranscript": { "$ref": "#/$defs/base64url" },
    "activationTranscript": { "$ref": "#/$defs/base64url" },
    "requestTranscript": { "$ref": "#/$defs/base64url" },
    "requestDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "base64url": { "type": "string", "minLength": 2, "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-][AQgw]|[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048])?$" },
    "activationWire": { "allOf": [{ "$ref": "#/$defs/base64url" }, { "maxLength": 87382 }] },
    "digest": { "type": "string", "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$" },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$" },
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "not": { "const": "00000000-0000-0000-0000-000000000000" } },
    "positiveUInt64": { "type": "string", "pattern": "^(?:[1-9][0-9]{0,18}|(?:1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5]))$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-9]))T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$", "allOf": [{ "not": { "pattern": "^[0-9]{4}-02-(?:30|31)" } }, { "not": { "pattern": "^(?!(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)-02-29T))[0-9]{4}-02-29T" } }] },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ciphertext"],
      "properties": { "kind": { "const": "node.endpoint.v1" }, "ciphertext": { "$ref": "#/$defs/base64url" } }
    },
    "activationV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "resultWire", "refreshWire", "leaseWire", "trustCommitWire", "admissionEvidenceWire", "claimProofSignature"],
      "properties": {
        "kind": { "const": "node.activation.v2" },
        "resultWire": { "$ref": "#/$defs/activationWire" },
        "refreshWire": { "$ref": "#/$defs/activationWire" },
        "leaseWire": { "$ref": "#/$defs/activationWire" },
        "trustCommitWire": { "$ref": "#/$defs/activationWire" },
        "admissionEvidenceWire": { "$ref": "#/$defs/activationWire" },
        "claimProofSignature": { "$ref": "#/$defs/signature" }
      }
    },
    "activationV3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "resultWire", "refreshWire", "leaseWire", "trustCommitWire", "admissionEvidenceWire", "cleanupCapabilityWire", "claimProofSignature"],
      "properties": {
        "kind": { "const": "node.activation.v3" },
        "resultWire": { "$ref": "#/$defs/activationWire" },
        "refreshWire": { "$ref": "#/$defs/activationWire" },
        "leaseWire": { "$ref": "#/$defs/activationWire" },
        "trustCommitWire": { "$ref": "#/$defs/activationWire" },
        "admissionEvidenceWire": { "$ref": "#/$defs/activationWire" },
        "cleanupCapabilityWire": { "$ref": "#/$defs/activationWire" },
        "claimProofSignature": { "$ref": "#/$defs/signature" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "accountID", "clientID", "nodeID", "trustEpoch", "audience", "sequence", "method", "path", "bodySHA256", "issuedAt", "signature"],
      "properties": {
        "kind": { "const": "node.signed-request.v1" },
        "accountID": { "$ref": "#/$defs/uuid" },
        "clientID": { "$ref": "#/$defs/uuid" },
        "nodeID": { "$ref": "#/$defs/uuid" },
        "trustEpoch": { "$ref": "#/$defs/positiveUInt64" },
        "audience": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]{0,253}[A-Za-z0-9])?(?::[1-9][0-9]{0,4})?$" },
        "sequence": { "$ref": "#/$defs/positiveUInt64" },
        "method": { "type": "string", "minLength": 1, "maxLength": 16, "pattern": "^[A-Z]+$" },
        "path": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^/[A-Za-z0-9._~!$&'()*+,;=:@/-]*(?:\\?[A-Za-z][A-Za-z0-9_-]{0,63}=[A-Za-z0-9_-]{1,256}(?:&[A-Za-z][A-Za-z0-9_-]{0,63}=[A-Za-z0-9_-]{1,256})*)?$" },
        "bodySHA256": { "$ref": "#/$defs/digest" },
        "issuedAt": { "$ref": "#/$defs/timestamp" },
        "signature": { "$ref": "#/$defs/signature" }
      }
    }
  }
}
