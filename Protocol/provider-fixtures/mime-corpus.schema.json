{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plainpost.olhapi.com/protocol/provider-fixtures/mime-corpus.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cases"],
  "properties": {
    "schemaVersion": {"const": 1},
    "cases": {
      "type": "array",
      "minItems": 20,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provider", "transport", "authentication", "script", "expected"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "provider": {"enum": ["gmail", "icloud", "generic"]},
        "transport": {"enum": ["implicit_tls", "starttls", "loopback_fixture"]},
        "authentication": {"enum": ["oauth_bearer", "app_password", "password"]},
        "script": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {"kind": {"enum": ["message", "generator"]}}
          }
        },
        "inputBase64": {"type": "string", "contentEncoding": "base64"},
        "generator": {"$ref": "#/$defs/generator"},
        "boundarySources": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/headerBoundary"}
        },
        "expected": {"$ref": "#/$defs/expected"}
      },
      "oneOf": [
        {"required": ["inputBase64"]},
        {"required": ["generator"]}
      ]
    },
    "generator": {
      "oneOf": [
        {"$ref": "#/$defs/simpleGenerator"},
        {"$ref": "#/$defs/attachmentBoundariesGenerator"}
      ]
    },
    "simpleGenerator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "dimension", "accepted", "rejected"],
      "properties": {
        "kind": {"enum": ["nested_multipart", "repeated_parts", "header_bytes", "attachment_bytes", "aggregate_attachment_bytes"]},
        "dimension": {"enum": ["depth", "part_count", "header_bytes", "attachment_bytes", "aggregate_attachment_bytes", "body_bytes"]},
        "accepted": {"type": "integer", "minimum": 1},
        "rejected": {"type": "integer", "minimum": 2}
      },
      "oneOf": [
        {"properties": {"kind": {"const": "nested_multipart"}, "dimension": {"const": "depth"}, "accepted": {"const": 64}, "rejected": {"const": 65}}},
        {"properties": {"kind": {"const": "repeated_parts"}, "dimension": {"const": "part_count"}, "accepted": {"const": 2000}, "rejected": {"const": 2001}}},
        {"properties": {"kind": {"const": "header_bytes"}, "dimension": {"const": "header_bytes"}, "accepted": {"const": 2097152}, "rejected": {"const": 2097153}}},
        {"properties": {"kind": {"const": "attachment_bytes"}, "dimension": {"const": "attachment_bytes"}, "accepted": {"const": 52428800}, "rejected": {"const": 52428801}}},
        {"properties": {"kind": {"const": "aggregate_attachment_bytes"}, "dimension": {"const": "aggregate_attachment_bytes"}, "accepted": {"const": 104857600}, "rejected": {"const": 104857601}}},
        {"properties": {"kind": {"const": "header_bytes"}, "dimension": {"const": "body_bytes"}, "accepted": {"const": 1048576}, "rejected": {"const": 1048577}}}
      ]
    },
    "attachmentBoundariesGenerator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "dimension", "attachmentCount", "attachmentMetadataBytes"],
      "properties": {
        "kind": {"const": "repeated_parts"},
        "dimension": {"const": "attachment_boundaries"},
        "attachmentCount": {"$ref": "#/$defs/attachmentCountBoundary"},
        "attachmentMetadataBytes": {"$ref": "#/$defs/attachmentMetadataBoundary"}
      }
    },
    "attachmentCountBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted", "rejected"],
      "properties": {"accepted": {"const": 256}, "rejected": {"const": 257}}
    },
    "attachmentMetadataBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted", "rejected"],
      "properties": {"accepted": {"const": 65536}, "rejected": {"const": 65537}}
    },
    "headerBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "header", "dimension", "accepted", "rejected"],
      "properties": {
        "kind": {"enum": ["message_ids", "addresses"]},
        "header": {"enum": ["in_reply_to", "references", "to", "cc"]},
        "dimension": {"enum": ["count", "aggregate_bytes"]},
        "accepted": {"enum": [256, 65536]},
        "rejected": {"enum": [257, 65537]}
      },
      "oneOf": [
        {"properties": {"kind": {"const": "message_ids"}, "header": {"enum": ["in_reply_to", "references"]}}},
        {"properties": {"kind": {"const": "addresses"}, "header": {"enum": ["to", "cc"]}}}
      ],
      "allOf": [
        {"if": {"properties": {"dimension": {"const": "count"}}}, "then": {"properties": {"accepted": {"const": 256}, "rejected": {"const": 257}}}},
        {"if": {"properties": {"dimension": {"const": "aggregate_bytes"}}}, "then": {"properties": {"accepted": {"const": 65536}, "rejected": {"const": 65537}}}}
      ]
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result"],
      "properties": {
        "result": {"enum": ["normalized", "resource_limit"]},
        "error": {"const": "provider resource limit exceeded"},
        "normalized": {"$ref": "#/$defs/normalized"}
      },
      "oneOf": [
        {"properties": {"result": {"const": "normalized"}}, "required": ["normalized"]},
        {"properties": {"result": {"const": "resource_limit"}}, "required": ["error"]}
      ]
    },
    "normalized": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "rfcMessageID", "date", "from", "sender", "replyTo", "to", "cc", "bcc", "inReplyTo", "references", "textBody", "htmlBody", "parts"],
      "properties": {
        "subject": {"type": "string"},
        "rfcMessageID": {"type": "string"},
        "date": {"type": "string"},
        "from": {"type": "array", "items": {"$ref": "#/$defs/address"}},
        "sender": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/address"}]},
        "replyTo": {"type": "array", "items": {"$ref": "#/$defs/address"}},
        "to": {"type": "array", "items": {"$ref": "#/$defs/address"}},
        "cc": {"type": "array", "items": {"$ref": "#/$defs/address"}},
        "bcc": {"type": "array", "items": {"$ref": "#/$defs/address"}},
        "inReplyTo": {"type": "array", "items": {"type": "string"}},
        "references": {"type": "array", "items": {"type": "string"}},
        "textBody": {"$ref": "#/$defs/body"},
        "htmlBody": {"$ref": "#/$defs/body"},
        "parts": {"type": "array", "items": {"$ref": "#/$defs/part"}}
      }
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "mailbox"],
      "properties": {"displayName": {"type": "string"}, "mailbox": {"type": "string"}}
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "value"],
      "properties": {"state": {"enum": ["absent", "complete", "malformed", "omitted_oversized"]}, "value": {"type": "string"}}
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "filename", "mediaType", "disposition", "contentID", "declaredSize"],
      "properties": {
        "path": {"type": "string"},
        "filename": {"type": "string"},
        "mediaType": {"type": "string"},
        "disposition": {"enum": ["none", "inline", "attachment"]},
        "contentID": {"type": "string"},
        "declaredSize": {"type": "integer", "minimum": 0},
        "bytes": {"$ref": "#/$defs/partBytes"},
        "bytesError": {"const": "protocol"}
      },
      "oneOf": [{"required": ["bytes"]}, {"required": ["bytesError"]}]
    },
    "partBytes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base64", "size", "sha256"],
      "properties": {
        "base64": {"type": "string", "contentEncoding": "base64"},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
