{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plainpost.app/protocol/node-sync-v1/node-sync.schema.json",
  "title": "Plainpost closed node-sync-v1 wire object",
  "$comment": "x-plainpost-maxUtf8Bytes and x-plainpost-maxCanonicalBytes are enforced by validate-max-utf8-bytes.cjs; maxLength remains conservative compatibility protection.",
  "x-plainpost-maxCanonicalBytes": 1048576,
  "oneOf": [
    { "$ref": "#/$defs/snapshotRequest" }, { "$ref": "#/$defs/deltaRequest" }, { "$ref": "#/$defs/searchRequest" },
    { "$ref": "#/$defs/messageRequest" }, { "$ref": "#/$defs/attachmentRequest" }, { "$ref": "#/$defs/mutationRequest" },
    { "$ref": "#/$defs/googleProvisionRequest" }, { "$ref": "#/$defs/mailboxAssignmentsRequest" }, { "$ref": "#/$defs/statusRequest" },
    { "$ref": "#/$defs/snapshotPage" }, { "$ref": "#/$defs/deltaPage" }, { "$ref": "#/$defs/searchPage" },
    { "$ref": "#/$defs/messageResult" }, { "$ref": "#/$defs/attachmentResult" }, { "$ref": "#/$defs/mutationResult" },
    { "$ref": "#/$defs/googleProvisionResult" }, { "$ref": "#/$defs/mailboxAssignmentsResult" }, { "$ref": "#/$defs/statusResult" },
    { "$ref": "#/$defs/problem" }, { "$ref": "#/$defs/operation" }
  ],
  "$defs": {
    "text": { "type": "string", "maxLength": 1048576, "x-plainpost-maxUtf8Bytes": 1048576, "pattern": "^[^\\u0000]*$" },
    "identifier": { "type": "string", "minLength": 1, "maxLength": 512, "x-plainpost-maxUtf8Bytes": 512, "pattern": "^[^\\u0000]*$" },
    "searchQuery": { "type": "string", "minLength": 1, "maxLength": 4096, "x-plainpost-maxUtf8Bytes": 4096, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$" },
    "messageReference": { "type": "string", "minLength": 1, "maxLength": 998, "x-plainpost-maxUtf8Bytes": 998, "pattern": "^[^\\u0000]*$" },
    "cursor": { "type": "string", "maxLength": 4096, "x-plainpost-maxUtf8Bytes": 4096, "pattern": "^[^\\u0000]*$" },
    "positiveDecimal": { "type": "string", "maxLength": 20, "x-plainpost-maxUtf8Bytes": 20, "pattern": "^(?:[1-9][0-9]{0,18}|(?:1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5]))$" },
    "decimal": { "oneOf": [{ "const": "0" }, { "$ref": "#/$defs/positiveDecimal" }] },
    "timestamp": { "type": "string", "maxLength": 20, "x-plainpost-maxUtf8Bytes": 20, "pattern": "^(?!0000)[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-9]))T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$", "allOf": [{ "not": { "pattern": "^[0-9]{4}-02-(?:30|31)" } }, { "not": { "pattern": "^(?!(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)-02-29T))[0-9]{4}-02-29T" } }] },
    "base64url": { "type": "string", "minLength": 1, "maxLength": 349526, "x-plainpost-maxUtf8Bytes": 349526, "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-][AQgw]|[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048])?$" },
    "rfc5322Base64url": { "type": "string", "minLength": 1, "maxLength": 245760, "x-plainpost-maxUtf8Bytes": 245760, "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-][AQgw]|[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048])?$" },
    "signature": { "type": "string", "minLength": 86, "maxLength": 86, "x-plainpost-maxUtf8Bytes": 86, "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$" },
    "digest": { "type": "string", "minLength": 43, "maxLength": 43, "x-plainpost-maxUtf8Bytes": 43, "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$" },
    "logicalMailboxID": { "type": "string", "minLength": 43, "maxLength": 43, "x-plainpost-maxUtf8Bytes": 43, "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$", "not": { "const": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" } },
    "uuid": { "type": "string", "minLength": 36, "maxLength": 36, "x-plainpost-maxUtf8Bytes": 36, "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "not": { "const": "00000000-0000-0000-0000-000000000000" } },
    "pageLimit": { "type": "integer", "minimum": 1, "maximum": 200 },
    "address": {
      "type": "object", "additionalProperties": false, "required": ["displayName", "mailbox"],
      "properties": {
        "displayName": { "type": "string", "maxLength": 4096, "x-plainpost-maxUtf8Bytes": 4096, "pattern": "^[^\\u0000]*$" },
        "mailbox": { "type": "string", "minLength": 1, "maxLength": 4096, "x-plainpost-maxUtf8Bytes": 4096, "pattern": "^[^\\u0000]*$" }
      }
    },
    "body": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["state", "value"], "properties": { "state": { "const": "complete" }, "value": { "$ref": "#/$defs/text" } } },
      { "type": "object", "additionalProperties": false, "required": ["state", "value"], "properties": { "state": { "enum": ["absent", "malformed", "omitted_oversized"] }, "value": { "type": "null" } } }
    ] },
    "attachment": {
      "type": "object", "additionalProperties": false, "required": ["contentDigest", "contentID", "disposition", "filename", "id", "mime", "size"],
      "properties": {
        "contentDigest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
        "contentID": { "oneOf": [{ "type": "null" }, { "type": "string", "maxLength": 998, "x-plainpost-maxUtf8Bytes": 998, "pattern": "^[^\\u0000]*$" }] },
        "disposition": { "enum": ["none", "inline", "attachment"] }, "filename": { "$ref": "#/$defs/identifier" }, "id": { "$ref": "#/$defs/identifier" },
        "mime": { "type": "string", "minLength": 1, "maxLength": 255, "x-plainpost-maxUtf8Bytes": 255, "pattern": "^[^\\u0000]*$" }, "size": { "$ref": "#/$defs/decimal" }
      }
    },
    "message": {
      "type": "object", "additionalProperties": false,
      "required": ["attachments", "bcc", "cc", "flags", "from", "htmlBody", "id", "inReplyTo", "labels", "receivedAt", "references", "replyTo", "sentAt", "subject", "textBody", "threadID", "to"],
      "properties": {
        "attachments": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/attachment" } }, "bcc": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/address" } }, "cc": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/address" } },
        "flags": { "type": "array", "maxItems": 200, "uniqueItems": true, "items": { "enum": ["answered", "deleted", "draft", "flagged", "seen"] } }, "from": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/address" } },
        "htmlBody": { "$ref": "#/$defs/body" }, "id": { "$ref": "#/$defs/identifier" }, "inReplyTo": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/messageReference" } },
        "labels": { "type": "array", "maxItems": 200, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } }, "receivedAt": { "$ref": "#/$defs/timestamp" },
        "references": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/messageReference" } }, "replyTo": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/address" } },
        "sentAt": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/timestamp" }] }, "subject": { "$ref": "#/$defs/text" }, "textBody": { "$ref": "#/$defs/body" }, "threadID": { "$ref": "#/$defs/identifier" }, "to": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/address" } }
      }
    },
    "change": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["kind", "logicalMailboxID", "messageID", "threadID"], "properties": { "kind": { "const": "upsert" }, "logicalMailboxID": { "$ref": "#/$defs/logicalMailboxID" }, "messageID": { "$ref": "#/$defs/identifier" }, "threadID": { "$ref": "#/$defs/identifier" } } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "logicalMailboxID", "messageID", "threadID"], "properties": { "kind": { "const": "membership_removed" }, "logicalMailboxID": { "$ref": "#/$defs/logicalMailboxID" }, "messageID": { "type": "null" }, "threadID": { "type": "null" } } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "logicalMailboxID", "messageID", "threadID"], "properties": { "kind": { "const": "tombstoned" }, "logicalMailboxID": { "$ref": "#/$defs/logicalMailboxID" }, "messageID": { "$ref": "#/$defs/identifier" }, "threadID": { "type": "null" } } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "logicalMailboxID", "messageID", "threadID"], "properties": { "kind": { "enum": ["epoch_reset", "baseline_complete"] }, "logicalMailboxID": { "$ref": "#/$defs/logicalMailboxID" }, "messageID": { "type": "null" }, "threadID": { "type": "null" } } }
    ] },
    "assignment": { "type": "object", "additionalProperties": false, "required": ["logicalMailboxID", "mailboxHandle"], "properties": { "logicalMailboxID": { "$ref": "#/$defs/logicalMailboxID" }, "mailboxHandle": { "$ref": "#/$defs/identifier" } } },
    "discoveredMailbox": { "type": "object", "additionalProperties": false, "required": ["displayName", "logicalMailboxID", "mailboxHandle", "role"], "properties": { "displayName": { "type": "string", "maxLength": 4096, "x-plainpost-maxUtf8Bytes": 4096, "pattern": "^[^\\u0000]*$" }, "logicalMailboxID": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/logicalMailboxID" }] }, "mailboxHandle": { "$ref": "#/$defs/identifier" }, "role": { "enum": ["inbox", "sent", "drafts", "trash", "junk", "archive", "all", "other"] } } },
    "saveDraftOperation": { "type": "object", "additionalProperties": false, "required": ["draftID", "expectedRevision", "kind", "rfc5322", "rfc5322Bytes"], "properties": { "bcc": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "string", "minLength": 3, "maxLength": 320, "x-plainpost-maxUtf8Bytes": 320, "pattern": "^[^\\u0000\\r\\n@ ]+@[^\\u0000\\r\\n@ ]+$" } }, "draftID": { "$ref": "#/$defs/identifier" }, "expectedRevision": { "$ref": "#/$defs/decimal" }, "kind": { "const": "save_draft" }, "rfc5322": { "$ref": "#/$defs/rfc5322Base64url" }, "rfc5322Bytes": { "type": "integer", "minimum": 1, "maximum": 184320 } } },
    "draftRevisionOperation": { "type": "object", "additionalProperties": false, "required": ["draftID", "expectedRevision", "kind"], "properties": { "draftID": { "$ref": "#/$defs/identifier" }, "expectedRevision": { "$ref": "#/$defs/positiveDecimal" }, "kind": { "enum": ["delete_draft", "send"] } } },
    "setLabelsOperation": { "type": "object", "additionalProperties": false, "required": ["addLabelIDs", "kind", "messageIDs", "removeLabelIDs"], "properties": { "addLabelIDs": { "type": "array", "maxItems": 200, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } }, "kind": { "const": "set_labels" }, "messageIDs": { "type": "array", "minItems": 1, "maxItems": 200, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } }, "removeLabelIDs": { "type": "array", "maxItems": 200, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } } }, "anyOf": [{ "properties": { "addLabelIDs": { "minItems": 1 } } }, { "properties": { "removeLabelIDs": { "minItems": 1 } } }] },
    "setReadOperation": { "type": "object", "additionalProperties": false, "required": ["kind", "messageIDs", "read"], "properties": { "kind": { "const": "set_read" }, "messageIDs": { "type": "array", "minItems": 1, "maxItems": 200, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } }, "read": { "type": "boolean" } } },
    "messageIDsOperation": { "type": "object", "additionalProperties": false, "required": ["kind", "messageIDs"], "properties": { "kind": { "enum": ["archive", "delete"] }, "messageIDs": { "type": "array", "minItems": 1, "maxItems": 200, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } } } },
    "setFlaggedOperation": { "type": "object", "additionalProperties": false, "required": ["flagged", "kind", "messageIDs"], "properties": { "flagged": { "type": "boolean" }, "kind": { "const": "set_flagged" }, "messageIDs": { "type": "array", "minItems": 1, "maxItems": 200, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } } } },
    "moveOperation": { "type": "object", "additionalProperties": false, "required": ["destinationMailboxPath", "kind", "messageIDs"], "properties": { "destinationMailboxPath": { "$ref": "#/$defs/identifier" }, "kind": { "const": "move" }, "messageIDs": { "type": "array", "minItems": 1, "maxItems": 200, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } } } },
    "operation": { "type": "object", "additionalProperties": false, "required": ["accountID", "authorityEpoch", "clientID", "idempotencyKey", "issuedAt", "kind", "logicalMailboxID", "nodeID", "operation", "signature", "trustEpoch"], "properties": { "accountID": { "$ref": "#/$defs/uuid" }, "authorityEpoch": { "$ref": "#/$defs/positiveDecimal" }, "clientID": { "$ref": "#/$defs/uuid" }, "idempotencyKey": { "$ref": "#/$defs/identifier" }, "issuedAt": { "$ref": "#/$defs/timestamp" }, "kind": { "const": "node-sync.operation.v1" }, "logicalMailboxID": { "$ref": "#/$defs/logicalMailboxID" }, "nodeID": { "$ref": "#/$defs/uuid" }, "operation": { "oneOf": [{ "$ref": "#/$defs/saveDraftOperation" }, { "$ref": "#/$defs/draftRevisionOperation" }, { "$ref": "#/$defs/setLabelsOperation" }, { "$ref": "#/$defs/setReadOperation" }, { "$ref": "#/$defs/messageIDsOperation" }, { "$ref": "#/$defs/setFlaggedOperation" }, { "$ref": "#/$defs/moveOperation" }] }, "signature": { "$ref": "#/$defs/signature" }, "trustEpoch": { "$ref": "#/$defs/positiveDecimal" } } },
    "snapshotRequest": { "type": "object", "additionalProperties": false, "required": ["after", "kind", "limit"], "properties": { "after": { "$ref": "#/$defs/cursor" }, "kind": { "const": "node-sync.snapshot-request.v1" }, "limit": { "$ref": "#/$defs/pageLimit" } } },
    "deltaRequest": { "type": "object", "additionalProperties": false, "required": ["after", "kind", "limit"], "properties": { "after": { "$ref": "#/$defs/cursor" }, "kind": { "const": "node-sync.delta-request.v1" }, "limit": { "$ref": "#/$defs/pageLimit" } } },
    "searchRequest": { "type": "object", "additionalProperties": false, "required": ["after", "kind", "limit", "logicalMailboxIDs", "query"], "properties": { "after": { "$ref": "#/$defs/cursor" }, "kind": { "const": "node-sync.search-request.v1" }, "limit": { "$ref": "#/$defs/pageLimit" }, "logicalMailboxIDs": { "type": "array", "maxItems": 200, "uniqueItems": true, "items": { "$ref": "#/$defs/logicalMailboxID" } }, "query": { "$ref": "#/$defs/searchQuery" } } },
    "messageRequest": { "type": "object", "additionalProperties": false, "required": ["kind", "messageID"], "properties": { "kind": { "const": "node-sync.message-request.v1" }, "messageID": { "$ref": "#/$defs/identifier" } } },
    "attachmentRequest": { "type": "object", "additionalProperties": false, "required": ["attachmentID", "kind"], "properties": { "attachmentID": { "$ref": "#/$defs/identifier" }, "kind": { "const": "node-sync.attachment-request.v1" } } },
    "mutationRequest": { "type": "object", "additionalProperties": false, "required": ["canonicalOperation", "canonicalOperationBytes", "kind"], "properties": { "canonicalOperation": { "$ref": "#/$defs/base64url" }, "canonicalOperationBytes": { "type": "integer", "minimum": 1, "maximum": 262144 }, "kind": { "const": "node-sync.mutation-request.v1" } } },
    "googleProvisionRequest": { "type": "object", "additionalProperties": false, "required": ["authorizationCode", "clientID", "codeVerifier", "kind", "redirectURI"], "properties": { "authorizationCode": { "type": "string", "minLength": 1, "maxLength": 4096, "x-plainpost-maxUtf8Bytes": 4096, "pattern": "^[^\\u0000]*$" }, "clientID": { "$ref": "#/$defs/identifier" }, "codeVerifier": { "type": "string", "minLength": 43, "maxLength": 128, "x-plainpost-maxUtf8Bytes": 128, "pattern": "^[A-Za-z0-9._~-]+$" }, "kind": { "const": "node-sync.google-provision-request.v1" }, "redirectURI": { "type": "string", "minLength": 1, "maxLength": 2048, "x-plainpost-maxUtf8Bytes": 2048, "pattern": "^[^\\u0000]*$" } } },
    "mailboxAssignmentsRequest": { "type": "object", "additionalProperties": false, "required": ["assignments", "kind"], "properties": { "assignments": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/assignment" } }, "kind": { "const": "node-sync.mailbox-assignments-request.v1" } } },
    "statusRequest": { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "node-sync.status-request.v1" } } },
    "snapshotPage": { "type": "object", "additionalProperties": false, "required": ["kind", "messages", "nextCursor", "revision"], "properties": { "kind": { "const": "node-sync.snapshot-page.v1" }, "messages": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/message" } }, "nextCursor": { "$ref": "#/$defs/cursor" }, "revision": { "$ref": "#/$defs/positiveDecimal" } } },
    "deltaPage": { "type": "object", "additionalProperties": false, "required": ["changes", "kind", "nextCursor", "revision"], "properties": { "changes": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/change" } }, "kind": { "const": "node-sync.delta-page.v1" }, "nextCursor": { "$ref": "#/$defs/cursor" }, "revision": { "$ref": "#/$defs/positiveDecimal" } } },
    "searchPage": { "type": "object", "additionalProperties": false, "required": ["kind", "messages", "nextCursor", "revision"], "properties": { "kind": { "const": "node-sync.search-page.v1" }, "messages": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/message" } }, "nextCursor": { "$ref": "#/$defs/cursor" }, "revision": { "$ref": "#/$defs/positiveDecimal" } } },
    "messageResult": { "type": "object", "additionalProperties": false, "required": ["kind", "message"], "properties": { "kind": { "const": "node-sync.message-result.v1" }, "message": { "$ref": "#/$defs/message" } } },
    "attachmentResult": { "type": "object", "additionalProperties": false, "required": ["attachment", "kind"], "properties": { "attachment": { "$ref": "#/$defs/attachment" }, "kind": { "const": "node-sync.attachment-result.v1" } } },
    "mutationResult": { "type": "object", "additionalProperties": false, "required": ["idempotencyKey", "kind", "state"], "properties": { "idempotencyKey": { "$ref": "#/$defs/identifier" }, "kind": { "const": "node-sync.mutation-result.v1" }, "state": { "enum": ["pending", "applied", "rejected", "conflicted", "delivery_uncertain"] } } },
    "googleProvisionResult": { "type": "object", "additionalProperties": false, "required": ["discoveredMailboxes", "kind", "providerIdentity"], "properties": { "discoveredMailboxes": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/discoveredMailbox" } }, "kind": { "const": "node-sync.google-provision-result.v1" }, "providerIdentity": { "$ref": "#/$defs/identifier" } } },
    "mailboxAssignmentsResult": { "type": "object", "additionalProperties": false, "required": ["assignments", "kind"], "properties": { "assignments": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/discoveredMailbox" } }, "kind": { "const": "node-sync.mailbox-assignments-result.v1" } } },
    "statusResult": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["kind", "revision", "state"], "properties": { "kind": { "const": "node-sync.status-result.v1" }, "revision": { "$ref": "#/$defs/decimal" }, "state": { "enum": ["ready", "degraded", "unavailable"] } } },
      { "type": "object", "additionalProperties": false, "required": ["assignments", "backup", "endpoint", "kind", "reachability", "revision", "state", "storage", "syncLag", "updateStatus", "version"], "properties": { "assignments": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/discoveredMailbox" } }, "backup": { "$ref": "#/$defs/identifier" }, "endpoint": { "type": "string", "minLength": 1, "maxLength": 2048, "x-plainpost-maxUtf8Bytes": 2048, "pattern": "^[^\\u0000]*$" }, "kind": { "const": "node-sync.status-result.v1" }, "providerIdentity": { "$ref": "#/$defs/identifier" }, "reachability": { "$ref": "#/$defs/identifier" }, "revision": { "$ref": "#/$defs/decimal" }, "state": { "enum": ["ready", "degraded", "unavailable"] }, "storage": { "$ref": "#/$defs/identifier" }, "syncLag": { "$ref": "#/$defs/identifier" }, "updateStatus": { "$ref": "#/$defs/identifier" }, "version": { "$ref": "#/$defs/identifier" } } }
    ] },
    "problem": { "type": "object", "additionalProperties": false, "required": ["category", "kind"], "properties": { "category": { "enum": ["invalid_request", "unauthorized", "conflict", "stale_cursor", "unavailable"] }, "kind": { "const": "node-sync.problem.v1" } } }
  }
}
